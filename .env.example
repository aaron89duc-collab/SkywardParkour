# Copy to .env.local (local builds) or set in Vercel → Settings → Environment Variables / your Android build.
# All optional: without them the game still works (maps self-hosted with the site, leaderboard off).

# Public URL of the Cloudflare R2 bucket with the map packs (manifest.json + files/). Set once, then maps
# can be added/updated on R2 without rebuilding the app.
VITE_CONTENT_URL=https://maps.example.com/

# Leaderboard API (server/: Cloudflare Worker + D1)
VITE_API_URL=https://skyward-api.example.workers.dev

# Admin password hash: node devtools/admin-hash.mjs "password"   (default password is built in)
# VITE_ADMIN_HASH=
